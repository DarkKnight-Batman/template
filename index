<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Youth President Invitation Designer</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Montserrat:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        .font-serif { font-family: 'Playfair Display', serif; }
        .font-sans { font-family: 'Montserrat', sans-serif; }
        
        @media print {
            body { background: white !important; padding: 0 !important; }
            .no-print { display: none !important; }
            .card-container { 
                box-shadow: none !important; 
                border: none !important;
                margin: 0 auto !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }

        /* Custom Gold Gradient for SVG */
        .gold-text {
            background: linear-gradient(to bottom, #fcf6ba 0%, #bf953f 25%, #b38728 50%, #fbf5b7 75%, #aa771c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body class="min-h-screen bg-slate-50 p-4 md:p-8 font-sans text-slate-900">

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        
        <!-- Editor Panel -->
        <div class="bg-white p-6 rounded-2xl shadow-xl border border-slate-200 no-print">
            <div class="flex items-center gap-2 mb-6">
                <i data-lucide="mail" class="text-orange-600"></i>
                <h2 class="text-xl font-bold">Invitation Designer</h2>
            </div>

            <!-- Template Selection -->
            <div class="mb-6">
                <label class="block text-xs font-bold text-slate-500 mb-3 uppercase tracking-wider">Select Template Style</label>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2" id="template-buttons">
                    <!-- Buttons generated by JS -->
                </div>
            </div>

            <div class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 mb-1 uppercase tracking-wider">Leader Name</label>
                        <input type="text" id="input-host" class="w-full p-2 border border-slate-300 rounded-lg text-sm font-bold outline-none focus:ring-2 focus:ring-orange-500">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 mb-1 uppercase tracking-wider">Designation</label>
                        <input type="text" id="input-designation" class="w-full p-2 border border-slate-300 rounded-lg text-sm font-bold outline-none focus:ring-2 focus:ring-orange-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1 uppercase tracking-wider">Event Title</label>
                    <input type="text" id="input-eventTitle" class="w-full p-2 border border-slate-300 rounded-lg text-sm font-bold uppercase outline-none focus:ring-2 focus:ring-orange-500">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1 uppercase tracking-wider">Upload Leader Photo</label>
                    <label class="flex items-center justify-center gap-2 p-3 border-2 border-dashed border-slate-300 rounded-xl cursor-pointer hover:bg-slate-50 transition-colors">
                        <i data-lucide="upload" class="text-slate-400"></i>
                        <span class="text-sm font-bold text-slate-600">Select Image File</span>
                        <input type="file" id="input-photo" accept="image/*" class="hidden">
                    </label>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 mb-1 uppercase tracking-wider">Date</label>
                        <input type="text" id="input-date" class="w-full p-2 border border-slate-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-orange-500">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 mb-1 uppercase tracking-wider">Time</label>
                        <input type="text" id="input-time" class="w-full p-2 border border-slate-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-orange-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1 uppercase tracking-wider">Venue Location</label>
                    <input type="text" id="input-venue" class="w-full p-2 border border-slate-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-orange-500">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 mb-1 uppercase tracking-wider">RSVP / Contact</label>
                    <input type="text" id="input-rsvp" class="w-full p-2 border border-slate-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-orange-500">
                </div>

                <div class="pt-4 border-t border-slate-100">
                    <button onclick="window.print()" class="w-full bg-gradient-to-r from-orange-600 via-slate-800 to-green-700 text-white font-black py-4 rounded-xl transition-all flex items-center justify-center gap-3 shadow-xl uppercase tracking-widest text-sm hover:opacity-90">
                        <i data-lucide="printer"></i>
                        Generate & Print
                    </button>
                </div>
            </div>
        </div>

        <!-- Preview Panel -->
        <div class="flex flex-col items-center">
            <div id="preview-container" class="card-container relative bg-white shadow-2xl overflow-hidden" style="width: 100%; max-width: 500px; aspect-ratio: 1 / 1.414;">
                <!-- Content injected by JS -->
            </div>
        </div>
    </div>

    <script>
        // State Management
        let activeTemplate = 5;
        let details = {
            header: "INDIAN NATIONAL CONGRESS",
            division: "BORABANDA DIVISION",
            host: "Vinay Pesingi",
            designation: "Youth President",
            inviteText: "You're cordially invited to celebrate",
            eventTitle: "VINAY'S",
            subTitle: "BIRTHDAY PARTY",
            date: "NOVEMBER 14TH, 2024",
            time: "07:00 PM",
            venue: "Borabanda Division, Hyderabad",
            rsvp: "123-456-7890",
            photoUrl: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=1000&auto=format&fit=crop"
        };

        const templates = [
            { id: 5, name: "Grand Gold" },
            { id: 1, name: "State Protocol" },
            { id: 2, name: "Classic White" },
            { id: 3, name: "Executive Gold" },
            { id: 4, name: "Modern Official" }
        ];

        const congressHandUrl = "https://upload.wikimedia.org/wikipedia/commons/thumb/6/63/Indian_National_Congress_hand_symbol.svg/1200px-Indian_National_Congress_hand_symbol.svg.png";

        // Initialization
        function init() {
            lucide.createIcons();
            setupEventListeners();
            renderTemplateButtons();
            syncInputs();
            renderPreview();
        }

        function setupEventListeners() {
            const inputs = ['host', 'designation', 'eventTitle', 'date', 'time', 'venue', 'rsvp'];
            inputs.forEach(id => {
                document.getElementById(`input-${id}`).addEventListener('input', (e) => {
                    details[id] = e.target.value;
                    renderPreview();
                });
            });

            document.getElementById('input-photo').addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onloadend = () => {
                        details.photoUrl = reader.result;
                        renderPreview();
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        function syncInputs() {
            Object.keys(details).forEach(key => {
                const el = document.getElementById(`input-${key}`);
                if (el) el.value = details[key];
            });
        }

        function renderTemplateButtons() {
            const container = document.getElementById('template-buttons');
            container.innerHTML = templates.map(t => `
                <button onclick="changeTemplate(${t.id})" class="template-btn py-3 px-1 text-[10px] font-black rounded-lg border-2 transition-all uppercase ${activeTemplate === t.id ? 'bg-slate-900 text-white border-slate-900 shadow-md scale-105' : 'bg-white text-slate-600 border-slate-100 hover:border-orange-400'}" data-id="${t.id}">
                    ${t.name}
                </button>
            `).join('');
        }

        function changeTemplate(id) {
            activeTemplate = id;
            renderTemplateButtons();
            renderPreview();
        }

        function renderPreview() {
            const container = document.getElementById('preview-container');
            
            if (activeTemplate === 5) {
                container.innerHTML = `
                <div class="h-full w-full bg-[#0d0d0d] relative flex flex-col items-center p-12 text-center text-white font-serif overflow-hidden">
                    <div class="absolute top-0 left-0 w-full h-full opacity-40 pointer-events-none">
                        <svg viewBox="0 0 400 600" class="w-full h-full">
                            <path d="M0,50 Q100,20 150,100 T300,50" stroke="url(#goldGrad)" stroke-width="1" fill="none" opacity="0.5"/>
                            <path d="M400,150 Q300,200 250,100 T100,150" stroke="url(#goldGrad)" stroke-width="1" fill="none" opacity="0.3"/>
                            <path d="M0,500 Q150,450 200,550 T400,500" stroke="url(#goldGrad)" stroke-width="2" fill="none" opacity="0.4"/>
                            <defs>
                                <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#bf953f" />
                                    <stop offset="25%" stop-color="#fcf6ba" />
                                    <stop offset="50%" stop-color="#b38728" />
                                    <stop offset="75%" stop-color="#fbf5b7" />
                                    <stop offset="100%" stop-color="#aa771c" />
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>

                    <div class="relative z-10 mt-4 mb-8">
                        <div class="w-52 h-64 border-[3px] border-[#c5a059] rounded-t-full p-1 overflow-hidden shadow-2xl">
                            <div class="w-full h-full rounded-t-full bg-slate-800 overflow-hidden border border-[#c5a059]">
                                <img src="${details.photoUrl}" alt="Leader" class="w-full h-full object-cover">
                            </div>
                        </div>
                        <div class="absolute -inset-4 border border-[#c5a059]/20 rounded-t-full pointer-events-none"></div>
                    </div>

                    <div class="z-10 space-y-2 mt-4">
                        <p class="text-sm italic font-light tracking-wide text-slate-300">${details.inviteText}</p>
                        <h1 class="text-5xl font-bold tracking-tight gold-text">
                            ${details.eventTitle}
                        </h1>
                        <h3 class="text-sm tracking-[0.4em] font-light text-[#c5a059] mt-2 uppercase">${details.subTitle}</h3>
                    </div>

                    <div class="z-10 w-full mt-10 space-y-6">
                        <div class="flex items-center justify-center gap-4 w-full px-4">
                            <div class="h-[1px] flex-1 bg-gradient-to-r from-transparent to-[#c5a059]/50"></div>
                            <div class="flex gap-4 text-[11px] font-black tracking-widest text-slate-200 uppercase">
                                <span>${details.date}</span>
                                <span>|</span>
                                <span>${details.time}</span>
                            </div>
                            <div class="h-[1px] flex-1 bg-gradient-to-l from-transparent to-[#c5a059]/50"></div>
                        </div>

                        <div class="space-y-4">
                            <p class="text-[11px] tracking-[0.2em] text-slate-400 font-light max-w-[250px] mx-auto leading-relaxed">${details.venue}</p>
                            <div class="pt-4">
                                <p class="text-[12px] font-black tracking-[0.3em] text-[#c5a059] uppercase">RSVP: ${details.rsvp}</p>
                            </div>
                        </div>
                    </div>

                    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 opacity-20 flex items-center gap-4">
                        <div class="h-[1px] w-12 bg-[#c5a059]"></div>
                        <img src="${congressHandUrl}" class="w-6 h-6 grayscale invert">
                        <div class="h-[1px] w-12 bg-[#c5a059]"></div>
                    </div>
                </div>`;
            } else if (activeTemplate === 1) {
                container.innerHTML = `
                <div class="h-full w-full bg-white relative flex flex-col items-center justify-between p-12 border-[1px] border-slate-200">
                    <div class="absolute top-0 left-0 w-full h-1 flex">
                        <div class="flex-1 bg-orange-500"></div>
                        <div class="flex-1 bg-white"></div>
                        <div class="flex-1 bg-green-600"></div>
                    </div>
                    <div class="z-10 text-center">
                        <div class="mb-4">
                            <img src="${congressHandUrl}" class="w-16 h-16 mx-auto mb-2">
                            <p class="text-[10px] font-black tracking-[0.4em] text-slate-400 uppercase">${details.header}</p>
                            <p class="text-xs font-bold text-slate-800 tracking-widest mt-1 uppercase">${details.division}</p>
                        </div>
                    </div>
                    <div class="z-10 text-center space-y-6">
                        <p class="text-sm font-serif italic text-slate-600">${details.host}</p>
                        <p class="text-[10px] font-black text-blue-900 uppercase tracking-widest">${details.designation}</p>
                        <div class="py-4 border-y border-slate-50">
                            <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight leading-none uppercase">
                                ${details.eventTitle}
                            </h1>
                        </div>
                    </div>
                    <div class="z-10 w-full space-y-4 text-center">
                        <div class="space-y-1">
                            <p class="text-sm font-black text-slate-800 uppercase">${details.date}</p>
                            <p class="text-xs font-bold text-slate-500 uppercase">${details.time}</p>
                        </div>
                        <p class="text-[10px] font-bold text-slate-700 uppercase tracking-tighter px-8">${details.venue}</p>
                        <div class="pt-8 border-t border-slate-50">
                            <p class="text-[10px] font-bold text-slate-800 uppercase tracking-widest leading-none">RSVP: ${details.rsvp}</p>
                        </div>
                    </div>
                </div>`;
            } else {
                container.innerHTML = `<div class="p-10 text-center text-slate-400">Template ${activeTemplate} Layout Preview...</div>`;
            }
        }

        window.onload = init;
    </script>
</body>
</html>
